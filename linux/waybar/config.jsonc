// ═══════════════════════════════════════════════════════════════
//  Waybar — gruvbox rice
//  The Linux counterpart of macos/sketchybar/. Same 36px floating
//  bar, same items, same order. Colours live in style.css.
// ═══════════════════════════════════════════════════════════════
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,

  "modules-left":   ["hyprland/workspaces", "hyprland/window"],
  "modules-center": [],
  "modules-right":  ["cpu", "memory", "pulseaudio", "battery", "clock"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": { "*": 9 }
  },

  "hyprland/window": {
    "format": "  {}",
    "max-length": 48,
    "separate-outputs": true
  },

  "cpu": {
    "interval": 3,
    "format": "  {usage}%",
    "states": { "warning": 50, "critical": 80 }
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "states": { "warning": 65, "critical": 85 }
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },

  "battery": {
    "interval": 60,
    "states": { "warning": 30, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "interval": 10,
    "format": "  {:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
