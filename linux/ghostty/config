# ─────────────────────────────────────────────────────────────
#  Ghostty — gruvbox rice (Linux)
#  Identical to macos/ghostty/config minus the macOS-only keys.
#  On Linux this file lives at ~/.config/ghostty/config.
# ─────────────────────────────────────────────────────────────

theme = gruvbox-dark-rice

font-family = "Iosevka Nerd Font"
font-size = 14
font-thicken = true
adjust-cell-height = 12%

background-opacity = 0.92
background-blur = 20
unfocused-split-opacity = 0.8

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = false

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.12

# One process, many windows — the Linux half of the macOS alt+enter fix.
# The default is `desktop`, which only enables single-instance when Ghostty is
# launched from its .desktop file; a WM `exec ghostty` bind is a bare CLI
# launch, so every alt+enter would fork a whole new app process. `true` makes
# any launch hand off to the running instance and open a window there.
gtk-single-instance = true

copy-on-select = clipboard
confirm-close-surface = false
shell-integration = zsh
shell-integration-features = cursor,sudo,title
