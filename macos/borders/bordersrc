#!/usr/bin/env bash
# JankyBorders — gruvbox window outlines
# active   = gruvbox bright yellow  #fabd2f
# inactive = gruvbox bg1            #3c3836

options=(
  style=round
  width=5.0
  hidpi=off
  active_color=0xfffabd2f
  inactive_color=0xff3c3836
  background_color=0x00000000
)

borders "${options[@]}"
